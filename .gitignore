# Repository root: AIE464. Allow only the mini-project and its documentation.
# Coursework, rosters and unrelated top-level files stay local.
/*
!/.gitignore
!/README.md
!/docs/
!/mini_project/

# Keep existing project references and the verified presentation brief only.
/docs/*
!/docs/PROJECT.md
!/docs/DATASET.md
!/docs/FINAL_BENCHMARK.md
!/docs/PHASE1_FEASIBILITY.md
!/docs/PHASE2A_SANITY.md
!/docs/KAGGLE_SMOKE.md
!/docs/KAGGLE_FULL_TRAINING.md
!/docs/PRESENTATION_BRIEF.md
!/docs/IMPROVEMENT_REPORT.md
!/docs/figures/
!/docs/superpowers/

/mini_project/*
!/mini_project/README.md
!/mini_project/PROJECT_SPEC.md
!/mini_project/prepare_benchmark_bundle.py
!/mini_project/src/
!/mini_project/tests/
!/mini_project/outputs/
!/mini_project/FINAL_SUBMISSION/
!/mini_project/results/
!/mini_project/pytest.ini
!/mini_project/requirements-dev.txt
!/mini_project/notebooks/
/mini_project/notebooks/*
!/mini_project/notebooks/final_colab.ipynb
!/mini_project/notebooks/build_final_colab.py

# Legacy notebooks stay local. Publish one immutable final notebook only.
/mini_project/FINAL_SUBMISSION/*
!/mini_project/FINAL_SUBMISSION/aie464-text-preserving-image-denoising-final.ipynb

# Development code remains available; recovery experiments stay local.
/mini_project/src/*
!/mini_project/src/*.py
!/mini_project/src/models/
/mini_project/src/models/*
!/mini_project/src/models/*.py
/mini_project/tests/*
!/mini_project/tests/*.py

# Explicit allowlist for the eight byte-verified copies from the final ZIP.
/mini_project/results/*
!/mini_project/results/final/
/mini_project/results/final/*
!/mini_project/results/final/final_test_benchmark.json
!/mini_project/results/final/qualitative_test_comparisons.png
!/mini_project/results/final/qualitative_zoom_comparisons.png
!/mini_project/results/final/training_validation_curves.png
!/mini_project/results/final/logs/
/mini_project/results/final/logs/*
!/mini_project/results/final/logs/cnn_l1/
!/mini_project/results/final/logs/dncnn_lite/
!/mini_project/results/final/logs/unet_l1/
!/mini_project/results/final/logs/unet_edge/
/mini_project/results/final/logs/*/*
!/mini_project/results/final/logs/*/validation.json

# Keep the frozen split metadata, never experiment outputs or checkpoints.
/mini_project/outputs/*
!/mini_project/outputs/phase1/
/mini_project/outputs/phase1/*
!/mini_project/outputs/phase1/split_manifest.json
!/mini_project/outputs/final/
/mini_project/outputs/final/*
!/mini_project/outputs/final/dibco_split.json

# Datasets and archives belong in local storage / Google Drive.
**/data/
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.7z
*.rar

# Model weights and large numerical artifacts.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5
*.npy
*.npz
*.bin

# Credentials and secrets: never add these with git add -f.
.env
.env.*
*.env
.kaggle/
kaggle*.json
credentials*.json
token*.json
secrets*.json
*service-account*.json
*service_account*.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.aws/
.ssh/
.gcp/
.netrc
.npmrc
.pypirc

# Python, notebook, tool and OS caches.
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
.coverage
htmlcov/
*.log
*.tmp
.DS_Store
Thumbs.db
augraphy_cache/
